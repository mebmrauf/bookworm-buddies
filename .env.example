# Database (TiDB Serverless or local MySQL)
# Format: mysql://<username>:<password>@<host>:<port>/<database>
MYSQL_URL=mysql://username:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/bookworm-buddies

# Cloudinary (Leave blank to run without image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin Login (Create password hash with: php tools/hash-password.php)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# App Settings
APP_URL=http://localhost:8000
CRON_TOKEN=
CONTACT_EMAIL=

# Email (Resend HTTPS API)
EMAIL_PASS=
EMAIL_FROM="Bookworm Buddies <verify@yourdomain.com>"
